{
	"schemaVersion": 1,
	"id": "simplefun",
	"version": "${version}",
	"name": "Simplefun",
	"description": "Small tweaks, big fun: a collection of configurable Vanilla+ features – Yeet (sneak-throw items), throwable bricks, the Brick Snowball, piggy transformation on eating porkchop, PvP player-head drops, and a No-Damage enchantment.",
	"authors": [
		"Ouzzi"
	],
	"contact": {
		"homepage": "https://github.com/Ouzzi/simplefun",
		"sources": "https://github.com/Ouzzi/simplefun",
		"issues": "https://github.com/Ouzzi/simplefun/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/simplefun/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.simplefun.Simplefun"
		],
        "client": [
            "com.simplefun.SimplefunClient"
        ],
		"fabric-datagen": [
			"com.simplefun.SimplefunDataGenerator"
		],
        "modmenu": [
          "com.simplefun.compat.ModMenuIntegration"
        ]
	},
	"mixins": [
		"simplefun.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.18.3",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*",
		"cloth-config": ">=21.11.150"
	},
	"suggests": {
		"modmenu": "*"
	}
}